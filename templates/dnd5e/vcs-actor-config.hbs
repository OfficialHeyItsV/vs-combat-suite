<div>
    <div class="form-group">
        <label>{{localize 'vs-combat-suite-dnd5e.portraitConfig.prepared.label'}}</label>
        <div class="form-fields">
            <select name="flags.vs-combat-suite.showPrepared">
            <option value="preparedOnly" {{#if (eq flags.vs-combat-suite.showPrepared "preparedOnly")}}selected{{/if}}>
                {{localize 'vs-combat-suite-dnd5e.portraitConfig.prepared.preparedOnly'}}
            </option>
            <option value="auto" {{#if (eq flags.vs-combat-suite.showPrepared "auto")}}selected{{/if}}>
                {{localize 'vs-combat-suite-dnd5e.portraitConfig.prepared.auto'}}
            </option>
            <option value="all" {{#if (eq flags.vs-combat-suite.showPrepared "all")}}selected{{/if}}>
                {{localize 'vs-combat-suite-dnd5e.portraitConfig.prepared.all'}}
            </option>
            </select>
        </div>
    </div>
</div>


